<Window x:Class="KmyBrowser.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings - Cardon Browser" Height="380" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Search engine" FontWeight="Bold" Margin="0,0,0,6"/>
        <ComboBox x:Name="EngineBox" Height="30"/>
        <TextBlock Text="Homepage" FontWeight="Bold" Margin="0,16,0,6"/>
        <ComboBox x:Name="HomeBox" Height="30">
            <ComboBoxItem Content="Dashboard"/>
            <ComboBoxItem Content="Blank"/>
            <ComboBoxItem Content="Custom"/>
        </ComboBox>
        <TextBlock Text="Custom URL" Margin="0,12,0,6"/>
        <TextBox x:Name="CustomUrlBox" Height="30" VerticalContentAlignment="Center" Padding="8,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Clear history" Width="110" Margin="0,0,8,0" Click="ClearHistory_Click"/>
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <TextBlock Margin="0,16,0,0" Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                   Text="Settings lưu ở %AppData%/CardonBrowser/settings.json — sửa file trực tiếp cũng được."/>
    </StackPanel>
</Window>
