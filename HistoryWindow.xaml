<Window x:Class="KmyBrowser.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History - Cardon Browser" Height="500" Width="700"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="ClearBtn" Content="Clear all" DockPanel.Dock="Right"
                    Width="90" Click="ClearBtn_Click"/>
            <TextBox x:Name="FilterBox" Height="28" VerticalContentAlignment="Center"
                     Padding="8,0" TextChanged="FilterBox_TextChanged"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray" FontSize="12"
                   Text="Double-click một dòng để mở lại. Lịch sử lưu ở %AppData%/CardonBrowser/history.json"/>
        <ListView x:Name="List" MouseDoubleClick="List_MouseDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Visited" Width="140" DisplayMemberBinding="{Binding VisitedAt}"/>
                    <GridViewColumn Header="Title" Width="220" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="URL" Width="300" DisplayMemberBinding="{Binding Url}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
